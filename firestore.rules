// ==========================================
// FIRESTORE SECURITY RULES
// ==========================================
// Roles: ADMIN, CENTRAL, SUPERVISOR, COORDINADOR, CLIENTE
//
// ADMIN: CRUD usuarios, clientes. Todo acceso.
// CENTRAL: Crea formularios. Ve TODOS los formularios. Valida formularios de cualquier cliente.
// SUPERVISOR: Diligencia formularios. No valida.
// COORDINADOR: Ve y valida formularios de sus clientes asignados.
// CLIENTE: Solo ve formularios/registros de su cuenta.
//
// Usuarios tienen clientIds[] (array). Puede estar vacío.
// ==========================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // FUNCIONES AUXILIARES
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return getUserProfile().role;
    }

    function isAdmin() {
      return isAuthenticated() && userRole() == 'ADMIN';
    }

    function isCentral() {
      return isAuthenticated() && userRole() == 'CENTRAL';
    }

    function isSupervisor() {
      return isAuthenticated() && userRole() == 'SUPERVISOR';
    }

    function isCoordinador() {
      return isAuthenticated() && userRole() == 'COORDINADOR';
    }

    function isCliente() {
      return isAuthenticated() && userRole() == 'CLIENTE';
    }

    function isActiveUser() {
      return isAuthenticated() && getUserProfile().isActive == true;
    }

    // Verifica si el usuario tiene el clientId en su array clientIds
    function hasClient(clientId) {
      return isAuthenticated() && clientId in getUserProfile().clientIds;
    }

    // ============================================
    // REGLAS POR COLECCIÓN
    // ============================================

    // --- CLIENTES ---
    // ADMIN: CRUD completo
    // Resto: lectura de clientes que tengan asignados
    match /clients/{clientId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        isCentral() ||
        hasClient(clientId)
      );
      allow create, update: if isAdmin() && isActiveUser();
      allow delete: if false;
    }

    // --- USUARIOS ---
    // ADMIN: CRUD completo
    // Otros: lectura de su propio perfil
    match /users/{userId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        request.auth.uid == userId
      );
      allow create: if isAdmin() && isActiveUser();
      allow update: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        request.auth.uid == userId
      );
      allow delete: if false;
    }

    // --- FORMULARIOS ---
    // ADMIN: CRUD completo
    // CENTRAL: CRUD completo (crea y ve todos)
    // SUPERVISOR: lectura de formularios de sus clientes
    // COORDINADOR: lectura de formularios de sus clientes
    // CLIENTE: lectura de formularios de su cliente
    match /forms/{formId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        isCentral() ||
        hasClient(resource.data.clientId)
      );
      allow create, update: if isAuthenticated() && isActiveUser() && (
        isAdmin() || isCentral()
      );
      allow delete: if false;
    }

    // --- REGISTROS ---
    // ADMIN: todo
    // CENTRAL: lectura y validación de todos los registros
    // SUPERVISOR: creación + lectura de sus propios registros
    // COORDINADOR: lectura y validación de registros de sus clientes
    // CLIENTE: lectura de registros de su cliente
    match /records/{recordId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        isCentral() ||
        (isSupervisor() && resource.data.userId == request.auth.uid) ||
        (isCoordinador() && hasClient(resource.data.clientId)) ||
        (isCliente() && hasClient(resource.data.clientId))
      );
      allow create: if isAuthenticated() && isActiveUser() && (
        isSupervisor() &&
        request.resource.data.userId == request.auth.uid
      );
      // Validar (update status) — CENTRAL y COORDINADOR (de sus clientes)
      allow update: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        isCentral() ||
        (isCoordinador() && hasClient(resource.data.clientId))
      );
      allow delete: if false;
    }

    // --- LOGS DE AUDITORÍA ---
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() || isCentral()
      );
      allow create: if isAuthenticated() && isActiveUser();
      allow update, delete: if false;
    }

    // --- CONFIGURACIÓN DEL SISTEMA ---
    match /systemConfig/{docId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if isAdmin() && isActiveUser();
    }

    // --- REGLA DEFAULT ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
