// ==========================================
// FIRESTORE SECURITY RULES (HARDENED)
// ==========================================
// Escrituras críticas (createUser, createForm, createRecord, assignRole)
// ahora pasan por Cloud Functions (Admin SDK bypasses rules).
// Las reglas bloquean creates directos desde el frontend.
// Lecturas se mantienen en el frontend con filtros por rol.
// ==========================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // FUNCIONES AUXILIARES
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return getUserProfile().role;
    }

    function isAdmin() {
      return isAuthenticated() && userRole() == 'ADMIN';
    }

    function isCentral() {
      return isAuthenticated() && userRole() == 'CENTRAL';
    }

    function isAnalyst() {
      return isAuthenticated() && userRole() == 'ANALISTA';
    }

    function canReviewIntelligence() {
      return isAuthenticated() && isActiveUser() && (isAdmin() || isCentral() || isAnalyst());
    }

    function isSupervisor() {
      return isAuthenticated() && userRole() == 'SUPERVISOR';
    }

    function isCoordinador() {
      return isAuthenticated() && userRole() == 'COORDINADOR';
    }

    function isCliente() {
      return isAuthenticated() && userRole() == 'CLIENTE';
    }

    function isGuarda() {
      return isAuthenticated() && userRole() == 'GUARDA';
    }

    function isActiveUser() {
      return isAuthenticated() && getUserProfile().isActive == true;
    }

    function hasClient(clientId) {
      return isAuthenticated() && clientId in getUserProfile().clientIds;
    }

    // ============================================
    // REGLAS POR COLECCIÓN
    // ============================================

    // --- CLIENTES ---
    match /clients/{clientId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        isCentral() ||
        hasClient(clientId)
      );
      // Solo ADMIN puede crear/editar clientes directamente
      allow create, update: if isAdmin() && isActiveUser();
      allow delete: if false;
    }

    // --- USUARIOS ---
    // CREATE bloqueado: se hace vía Cloud Function createUser (Admin SDK)
    match /users/{userId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        isCentral() ||
        request.auth.uid == userId
      );
      // Create bloqueado desde frontend — Cloud Function lo maneja
      allow create: if false;
      // Solo ADMIN puede actualizar perfiles desde el frontend.
      // Los campos críticos role y clientIds se modifican exclusivamente
      // mediante Cloud Function assignRole (Admin SDK).
      allow update: if isAdmin() && isActiveUser()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'clientIds']);
      allow delete: if false;
    }

    // --- FORMULARIOS ---
    // CREATE bloqueado: se hace vía Cloud Function createForm (Admin SDK)
    match /forms/{formId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        isCentral() ||
        hasClient(resource.data.clientId)
      );
      // Create bloqueado desde frontend
      allow create: if false;
      // Update permitido para ADMIN/CENTRAL (cambiar estado, versión, campos)
      allow update: if isAuthenticated() && isActiveUser() && (
        isAdmin() || isCentral()
      );
      allow delete: if false;
    }

    // --- REGISTROS ---
    // CREATE bloqueado: se hace vía Cloud Function createRecord (Admin SDK)
    match /records/{recordId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        isCentral() ||
        ((isSupervisor() || isGuarda()) && resource.data.userId == request.auth.uid) ||
        (isCoordinador() && hasClient(resource.data.clientId)) ||
        (isCliente() && hasClient(resource.data.clientId))
      );
      // Create bloqueado desde frontend
      allow create: if false;
      // Update (validar status): ADMIN, CENTRAL, COORDINADOR (de sus clientes)
      // Las actualizaciones de estado pasan por Cloud Function para auditoría.
      allow update: if false;
      allow delete: if false;
    }

    // --- MINUTA DE CONTROL ---
    match /minuteEntries/{entryId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() ||
        isCentral() ||
        (isSupervisor() && hasClient(resource.data.clientId)) ||
        (isCoordinador() && hasClient(resource.data.clientId)) ||
        (isGuarda() && hasClient(resource.data.clientId))
      );
      allow create: if isAuthenticated() && isActiveUser() && (
        isAdmin() || isCentral() || isSupervisor() || isCoordinador() || isGuarda()
      ) && request.resource.data.keys().hasAll(['clientId', 'userId', 'userName', 'userRole', 'type', 'content', 'createdAt', 'isClosed'])
        && request.resource.data.keys().hasOnly(['clientId', 'userId', 'userName', 'userRole', 'type', 'content', 'createdAt', 'isClosed', 'location'])
        && request.resource.data.clientId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userRole == getUserProfile().role
        && request.resource.data.userName == getUserProfile().fullName
        && request.resource.data.type in ['novedad', 'observacion', 'incidente', 'reporte', 'consigna_general']
        && request.resource.data.content is string
        && request.resource.data.createdAt is string
        && request.resource.data.isClosed == false
        && (isAdmin() || isCentral() || hasClient(request.resource.data.clientId))
        && (request.resource.data.type != 'consigna_general' || isAdmin() || isCentral() || isCoordinador());
      allow update: if isAuthenticated() && isActiveUser() && (
        isAdmin() || isCentral() || (isCoordinador() && hasClient(resource.data.clientId))
      ) && resource.data.type == 'consigna_general'
        && request.resource.data.isClosed == true
        && resource.data.isClosed == false
        && request.resource.data.closedBy == request.auth.uid
        && request.resource.data.closedByName == getUserProfile().fullName
        && request.resource.data.closedAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isClosed', 'closedBy', 'closedByName', 'closedAt']);
      allow delete: if false;
    }

    // --- LOGS DE AUDITORÍA ---
    // Create bloqueado desde frontend: Cloud Functions escriben auditoría
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() || isCentral()
      );
      allow create: if false;
      allow update, delete: if false;
    }

    // --- CONFIGURACIÓN DEL SISTEMA ---
    match /systemConfig/{docId} {
      allow read: if isAuthenticated() && isActiveUser();
      allow write: if isAdmin() && isActiveUser();
    }

    // --- INTELIGENCIA: lectura restringida a ADMIN/CENTRAL ---
    // Las escrituras se realizan exclusivamente mediante Cloud Functions.
    match /intelligenceCases/{caseId} {
      allow read: if canReviewIntelligence();
      allow create, update, delete: if false;
    }

    match /intelligenceReports/{reportId} {
      allow read: if isAuthenticated() && isActiveUser() && (
        isAdmin() || isCentral() || isAnalyst() ||
        ((isSupervisor() || isCoordinador() || isGuarda()) && resource.data.createdBy == request.auth.uid)
      );
      allow create, update, delete: if false;
    }

    match /intelligenceTimeline/{entryId} {
      allow read: if canReviewIntelligence();
      allow create, update, delete: if false;
    }

    match /intelligenceMatches/{matchId} {
      allow read: if canReviewIntelligence();
      allow create, update, delete: if false;
    }

    match /intelligenceVerifications/{verificationId} {
      allow read: if canReviewIntelligence();
      allow create, update, delete: if false;
    }

    // --- REGLA DEFAULT ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
